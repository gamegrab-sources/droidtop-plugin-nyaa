{
  "id": "gamegrab.nyaa",
  "origin": "gamegrab",
  "label": "Nyaa",
  "description": "Searches Nyaa and Sukebei for games and opens a torrent in your torrent app.",
  "version": "0.6.0",
  "kind": "python",
  "contractVersion": 3,
  "category": "sources",
  "requestsRoot": false,
  "abis": [],
  "provides": [
    {
      "point": "library.sources",
      "version": 1,
      "id": "nyaa",
      "label": "Nyaa",
      "systems": "*"
    },
    {
      "point": "ui.facets",
      "version": 1,
      "id": "main",
      "targets": ["settings.page", "search.filter"]
    }
  ],
  "permissions": [
    {
      "id": "net.domains",
      "domains": [
        "nyaa.si",
        "sukebei.nyaa.si"
      ],
      "reason": "Searches the sites' public RSS feeds"
    },
    {
      "id": "apps.view",
      "reason": "Hands a torrent's magnet link to a torrent app you have installed (droidtop has no torrent client)"
    }
  ]
}
